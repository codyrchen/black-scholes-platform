# OpenAI (required for voice agent)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=nova

# Twilio (required for phone calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Voice agent branding
COMPANY_NAME=Black-Scholes Platform
AGENT_NAME=Alex

# Public URL where Twilio can reach your webhooks (use ngrok for local dev)
PUBLIC_URL=https://your-ngrok-url.ngrok.io

# Optional: transfer escalated calls to a human agent
HUMAN_TRANSFER_NUMBER=+15551234567

# Optional: low-latency realtime mode (requires voice_stream_server.py + ngrok)
VOICE_USE_REALTIME=false
VOICE_WS_PUBLIC_URL=wss://your-ngrok-ws-url.ngrok.io
VOICE_WS_PORT=8765

# Flask server
PORT=5001
HOST=0.0.0.0
